<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/authFragment">

    <fragment
        android:id="@+id/authFragment"
        android:name="com.partyhub.auth.AuthFragment"
        android:label="@string/nav_label_login"
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_authFragment_to_hubFragment"
            app:destination="@id/hubFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/hubFragment"
        android:name="com.partyhub.feature.hub.HubFragment"
        android:label="PartyHub"
        tools:layout="@layout/fragment_hub" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.partyhub.feature.history.HistoryFragment"
        android:label="@string/nav_label_history"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.partyhub.feature.settings.SettingsFragment"
        android:label="@string/nav_label_settings"
        tools:layout="@layout/fragment_settings" />

    <include app:graph="@navigation/nav_mind" />
    <include app:graph="@navigation/nav_as" />

</navigation>
